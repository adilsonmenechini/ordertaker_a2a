# ╔══════════════════════════════════════════════════════════════╗
# ║  🥟 Pastelaria Virtual — Environment Variables             ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Docker: values are loaded from .env automatically
# Local:  python-dotenv loads .env at startup

# ── LLM (opcional — fallback determinístico funciona sem) ─────
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ── Backend Agent Ports ────────────────────────────────────────
FILA_PORT=9001
COZINHA_PORT=9002
PREPARO_PORT=9003
ENTREGA_PORT=9004

# ── Backend Agent URLs (used by frontend & sdk_client) ────────
# Docker: http://backend:9001  /  Local: http://localhost:9001
FILA_AGENT_URL=http://localhost:9001
COZINHA_AGENT_URL=http://localhost:9002
PREPARO_AGENT_URL=http://localhost:9003
ENTREGA_AGENT_URL=http://localhost:9004

# ── Orchestrator (default: Fila agent) ────────────────────────
ORCHESTRATOR_URL=http://localhost:9001

# ── CORS ───────────────────────────────────────────────────────
# Allowed origins for Cross-Origin requests (comma-separated, or * for all)
CORS_ORIGINS=*

# ── Frontend (Next.js) ────────────────────────────────────────
# Optional — CopilotKit Intelligence
# COPILOTKIT_API_KEY=
